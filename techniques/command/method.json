{
  "id": "command-execution",
  "name": "Command Execution",
  "language": "cpp",
  "architectures": [
    "x64",
    "x86"
  ],
  "build_types": [
    "release",
    "debug"
  ],
  "operational": {
    "alias": "command",
    "category": "Execution",
    "runtime": "native",
    "privilege": "user",
    "deployable": true,
    "hidden": false,
    "validation": "runtime-tested"
  },
  "requires_payload": false,
  "payload_types": [],
  "payload_contract": {
    "required": false,
    "types": [],
    "transforms": [
      "copy"
    ],
    "default_transform": "copy",
    "min_size_bytes": 0,
    "max_size_bytes": 1
  },
  "providers": [],
  "parameters": {},
  "runtime_arguments": [
    {
      "name": "command",
      "type": "str",
      "required": true,
      "description": "Command and arguments passed to cmd.exe"
    }
  ],
  "sources": [
    {
      "template": "main.cpp.tpl",
      "output": "main.cpp",
      "compile": true
    }
  ],
  "output_name": "mifa-command.exe",
  "compiler_flags": [
    "-municode"
  ]
}
